<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="using:Avalonia.Data.Converters"
        x:Class="Vortex.Desktop.SettingsWindow"
        Width="850" Height="580"
        MinWidth="800" MinHeight="500"
        Title="Ayarlar"
        Background="#08101E"
        WindowStartupLocation="CenterOwner">
  <Grid ColumnDefinitions="220,*">
    <!-- Sol Kategori Menüsü -->
    <Border Grid.Column="0" Background="#0C1525" BorderBrush="#173B55" BorderThickness="0,0,1,0" Padding="14">
      <Grid RowDefinitions="*,Auto">
        <ListBox Grid.Row="0" Background="Transparent" BorderThickness="0"
                 ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding}" Foreground="#F4FBFF" FontSize="13" Padding="6" FontWeight="SemiBold"/>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <!-- Kapatma/Tamamlama Butonu -->
        <Button Grid.Row="1" Content="Kapat" Click="CloseButton_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="#1c2c4c"/>
      </Grid>
    </Border>

    <!-- Sağ Paneli -->
    <Border Grid.Column="1" Padding="20">
      <Grid>
        <!-- General Category -->
        <ScrollViewer IsVisible="{Binding IsGeneralSelected}">
          <StackPanel Spacing="16">
            <TextBlock Text="Genel Ayarlar" FontSize="20" FontWeight="Bold" Foreground="#3FD5FF" />
            <Border Height="1" Background="#173B55" />
            <CheckBox Content="Uygulama açılışında beni hatırla" IsChecked="{Binding RememberMe}" Foreground="#F4FBFF" />
            <CheckBox Content="Çevrimdışı Mod (yerel şifreli SQLite, sunucu senkronu kapalı)" IsChecked="{Binding IsOfflineMode}" Foreground="#F4FBFF" />
            <TextBlock Text="Çevrimdışı modda sohbetler sunucuya gönderilmez; veriler yalnızca bu bilgisayardaki şifreli yerel veritabanında tutulur." Foreground="#8EA8BC" FontSize="11" TextWrapping="Wrap" />
            <StackPanel Spacing="6">
              <TextBlock Text="Kullanıcı Depolama Alanı Kotası" Foreground="#9FB7C9" FontSize="12" FontWeight="SemiBold"/>
              <ProgressBar Height="8" Maximum="5368709120" Value="{Binding StorageUsedBytes}" Foreground="#3FD5FF" Background="#111A2A" CornerRadius="4" />
              <TextBlock Text="{Binding StorageQuotaText}" Foreground="#8EA8BC" FontSize="11" />
              <TextBlock Text="Kota uyarısı: 5 GB depolama sınırına yaklaştığınızda uyarı alırsınız. İhtiyaç halinde arşivleyin veya silin." Foreground="#F87171" FontSize="11" TextWrapping="Wrap" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>

        <!-- Appearance Category -->
        <ScrollViewer IsVisible="{Binding IsAppearanceSelected}">
          <StackPanel Spacing="16">
            <TextBlock Text="Görünüm ve Ölçek Ayarları" FontSize="20" FontWeight="Bold" Foreground="#3FD5FF" />
            <Border Height="1" Background="#173B55" />

            <TextBlock Text="Tema" Foreground="#9FB7C9" FontSize="12" FontWeight="SemiBold"/>
            <TextBlock Text="Vortex Desktop her zaman koyu tema kullanır."
                       Foreground="#7A93A8" FontSize="11" TextWrapping="Wrap"/>

            <!-- Arayüz Ölçeği bölümü -->
            <TextBlock Text="Ana Arayüz Ölçeği" Foreground="#9FB7C9" FontSize="12" FontWeight="SemiBold" Margin="0,10,0,0"/>
            <ComboBox ItemsSource="{Binding MainUiScales}" SelectedItem="{Binding SelectedMainUiScale}" HorizontalAlignment="Stretch" />

            <TextBlock Text="Compact Bar Ölçeği" Foreground="#9FB7C9" FontSize="12" FontWeight="SemiBold" Margin="0,10,0,0"/>
            <ComboBox ItemsSource="{Binding CompactUiScales}" SelectedItem="{Binding SelectedCompactUiScale}" HorizontalAlignment="Stretch" />
          </StackPanel>
        </ScrollViewer>

        <!-- SES -->
        <ScrollViewer IsVisible="{Binding IsVoiceSelected}">
          <StackPanel Spacing="16">
            <TextBlock Text="Ses ve Mikrofon Ayarları" FontSize="20" FontWeight="Bold" Foreground="#3FD5FF" />
            <Border Height="1" Background="#173B55" />
            <CheckBox Content="Sürekli Dinleme (Yerel transkript kapısı)" IsChecked="{Binding IsAlwaysListening}" Foreground="#F4FBFF"/>
            <TextBlock Text="{Binding WakeWordEngineStatusText}" Foreground="#FBBF24" FontSize="11" TextWrapping="Wrap"/>

            <TextBlock Text="Mikrofon Giriş Cihazı Seçimi" Foreground="#9FB7C9" FontSize="12" FontWeight="SemiBold"/>
            <ComboBox ItemsSource="{Binding AudioInputDevices}" SelectedItem="{Binding SelectedInputDevice}" HorizontalAlignment="Stretch" />

            <TextBlock Text="Mikrofon Ses Seviyesi (Hassasiyet)" Foreground="#9FB7C9" FontSize="12" FontWeight="SemiBold"/>
            <Slider Minimum="0" Maximum="2" Value="{Binding InputVolume}" />

            <TextBlock Text="Hoparlör Ses Çıkış Cihazı Seçimi" Foreground="#9FB7C9" FontSize="12" FontWeight="SemiBold"/>
            <ComboBox ItemsSource="{Binding AudioOutputDevices}" SelectedItem="{Binding SelectedOutputDevice}" HorizontalAlignment="Stretch" />

            <TextBlock Text="Hoparlör Ses Seviyesi" Foreground="#9FB7C9" FontSize="12" FontWeight="SemiBold"/>
            <Slider Minimum="0" Maximum="2" Value="{Binding OutputVolume}" />

            <CheckBox Content="Gürültü Engelleme Aktif" IsChecked="{Binding NoiseCancellationEnabled}" Foreground="#F4FBFF"/>
            <CheckBox Content="Otomatik Sesli Yanıt (Final Yanıtını Oku)" IsChecked="{Binding AutoVoiceReplyEnabled}" Foreground="#F4FBFF"/>

            <TextBlock Text="VAD (Ses Aktivite Algılama) Hassasiyeti" Foreground="#9FB7C9" FontSize="12" FontWeight="SemiBold"/>
            <Slider Minimum="0" Maximum="1" Value="{Binding VadThreshold}" />

            <TextBlock Text="Whisper.cpp Modeli" Foreground="#9FB7C9" FontSize="12" FontWeight="SemiBold"/>
            <ComboBox SelectedIndex="{Binding WhisperModelIndex}" HorizontalAlignment="Stretch">
              <ComboBoxItem Content="Çok Hızlı — Tiny" />
              <ComboBoxItem Content="Düşük Donanım — Base" />
              <ComboBoxItem Content="Dengeli — Small (Önerilen)" />
              <ComboBoxItem Content="Yüksek Doğruluk — Medium" />
              <ComboBoxItem Content="Maksimum Performans — Large V3 Turbo" />
            </ComboBox>
            <TextBlock Text="{Binding WhisperModelSizeText}" Foreground="#8EA8BC" FontSize="11"/>
            <TextBlock Text="Whisper modeli yoksa buradan indirin. Mevcut modeli değiştirmek için listeden seçin; indirilmiş model otomatik kullanılır." Foreground="#64748B" FontSize="11" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="Modeli İndir / Değiştir" Command="{Binding DownloadWhisperModelCommand}" Background="#1c2c4c"/>
              <Button Content="Güncel Modelleri Gör" Command="{Binding OpenWhisperModelsPageCommand}" Background="#0f172a"/>
            </StackPanel>
            <TextBlock Text="{Binding WhisperStatusText}" Foreground="#BFDBFE" FontSize="11" TextWrapping="Wrap"/>
            <Border Background="#020617" BorderBrush="#1E3A5F" BorderThickness="1" CornerRadius="6" Padding="6" MaxHeight="120" IsVisible="{Binding WhisperInstallLog, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock Text="{Binding WhisperInstallLog}" TextWrapping="Wrap" FontFamily="Consolas,Courier New,monospace" FontSize="11" Foreground="#A5B4FC"/>
              </ScrollViewer>
            </Border>
            <Button Content="Yapay zeka asistanına danış" Command="{Binding ConsultWhisperInstallFailureCommand}" IsVisible="{Binding WhisperInstallLog, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" Background="#0F766E" Foreground="#ECFDF5" HorizontalAlignment="Left"/>

            <TextBlock Text="Kokoro Yerel TTS Önerisi" Foreground="#9FB7C9" FontSize="12" FontWeight="SemiBold"/>
            <Border Background="#071A33" BorderBrush="#1D4ED8" BorderThickness="1" CornerRadius="8" Padding="10">
              <StackPanel Spacing="8">
                <TextBlock Text="{Binding KokoroStatusText}" Foreground="#BFDBFE" TextWrapping="Wrap"/>
                <Border Background="#020617" BorderBrush="#1E3A5F" BorderThickness="1" CornerRadius="6" Padding="6" MaxHeight="120" IsVisible="{Binding KokoroInstallLog, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}">
                  <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBlock Text="{Binding KokoroInstallLog}" TextWrapping="Wrap" FontFamily="Consolas,Courier New,monospace" FontSize="11" Foreground="#A5B4FC"/>
                  </ScrollViewer>
                </Border>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Content="Kur / İndir" Command="{Binding InstallKokoroCommand}" Background="#0B3A75" Foreground="#FFFFFF" HorizontalAlignment="Left"/>
                  <Button Content="Arka planda devam et ve ayarları kapat" Click="CloseButton_Click" Background="#1c2c4c" Foreground="#E2E8F0" HorizontalAlignment="Left"/>
                  <Button Content="Belgeler" Command="{Binding OpenKokoroDocsCommand}" Background="Transparent" Foreground="#93C5FD" HorizontalAlignment="Left"/>
                  <Button Content="Yapay zeka asistanına danış" Command="{Binding ConsultKokoroInstallFailureCommand}" IsVisible="{Binding IsKokoroInstallFailed}" Background="#0F766E" Foreground="#ECFDF5" HorizontalAlignment="Left"/>
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <!-- AI Models Category -->
        <ScrollViewer IsVisible="{Binding IsAiModelsSelected}">
          <StackPanel Spacing="16">
            <TextBlock Text="Yapay Zeka Modelleri" FontSize="20" FontWeight="Bold" Foreground="#3FD5FF" />
            <Border Height="1" Background="#173B55" />
            <TextBlock Text="Çevrimdışı Özel OpenAI Uyumlu API" Foreground="#9FB7C9" FontSize="12" TextWrapping="Wrap" />
            <TextBlock Text="Bu ayar yalnız Çevrimdışı Mod açıkken Desktop sohbeti tarafından doğrudan kullanılır. Giriş yapılmış normal sohbet, Vortex.Server sağlayıcı politikasını kullanır; bu URL ve anahtar o akışa gönderilmez." Foreground="#8EA8BC" FontSize="11" TextWrapping="Wrap" />
            <StackPanel Spacing="6">
              <TextBlock Text="API Base URL" Foreground="#9FB7C9" FontSize="12" FontWeight="SemiBold" />
              <TextBox Text="{Binding LocalLlmBaseUrl}" PlaceholderText="Yerel, public veya özel API URL" />
            </StackPanel>
            <StackPanel Spacing="6">
              <TextBlock Text="Model / seçici" Foreground="#9FB7C9" FontSize="12" FontWeight="SemiBold" />
              <TextBox Text="{Binding LocalLlmModel}" PlaceholderText="Örn. llama3.1, gpt-4o-mini, qwen2.5 vb." />
            </StackPanel>
            <StackPanel Spacing="6">
              <TextBlock Text="API anahtarı (gerekiyorsa)" Foreground="#9FB7C9" FontSize="12" FontWeight="SemiBold" />
              <TextBox PasswordChar="*" Text="{Binding LocalLlmApiKey}" />
            </StackPanel>
            <TextBlock Text="{Binding LocalLlmStatusText}" Foreground="#8EA8BC" FontSize="12" TextWrapping="Wrap" />
            <Button Content="Çevrimdışı API Bağlantısını Test Et" Command="{Binding TestLocalLlmConnectionCommand}" HorizontalAlignment="Left" Background="#1c2c4c" Foreground="#F4FBFF" Padding="12,6" />
          </StackPanel>
        </ScrollViewer>

        <!-- Providers Category -->
        <ScrollViewer IsVisible="{Binding IsProvidersSelected}">
          <StackPanel Spacing="16">
            <TextBlock Text="Sağlayıcı Yapılandırmaları" FontSize="20" FontWeight="Bold" Foreground="#3FD5FF" />
            <Border Height="1" Background="#173B55" />
            <TextBlock Text="Vortex bulut ve yerel proxy sağlayıcıları listesi." Foreground="#8EA8BC" FontSize="12" />

            <TextBlock Text="ElevenLabs TTS Yapılandırması" FontSize="16" FontWeight="SemiBold" Foreground="#3FD5FF" Margin="0,10,0,0" />
            <CheckBox Content="ElevenLabs TTS Etkin" IsChecked="{Binding ElevenLabsTtsEnabled}" Foreground="#F4FBFF" />
            <StackPanel Spacing="6">
              <TextBlock Text="API Anahtarı (API Key)" Foreground="#9FB7C9" FontSize="12" FontWeight="SemiBold" />
              <TextBox PasswordChar="*" Text="{Binding ElevenLabsApiKey}" />
            </StackPanel>
            <StackPanel Spacing="6">
              <TextBlock Text="Ses Kimliği (Voice ID)" Foreground="#9FB7C9" FontSize="12" FontWeight="SemiBold" />
              <TextBox Text="{Binding ElevenLabsVoiceId}" />
            </StackPanel>

            <TextBlock Text="MinMax TTS Yapılandırması" FontSize="16" FontWeight="SemiBold" Foreground="#3FD5FF" Margin="0,20,0,0" />
            <CheckBox Content="MinMax TTS Etkin" IsChecked="{Binding MinMaxTtsEnabled}" Foreground="#F4FBFF" />
            <StackPanel Spacing="6">
              <TextBlock Text="API Anahtarı (API Key)" Foreground="#9FB7C9" FontSize="12" FontWeight="SemiBold" />
              <TextBox PasswordChar="*" Text="{Binding MinMaxApiKey}" />
            </StackPanel>
            <StackPanel Spacing="6">
              <TextBlock Text="Ses Kimliği (Voice ID)" Foreground="#9FB7C9" FontSize="12" FontWeight="SemiBold" />
              <TextBox Text="{Binding MinMaxTtsVoiceId}" />
            </StackPanel>
            <StackPanel Spacing="6">
              <TextBlock Text="Model Kimliği (Model ID)" Foreground="#9FB7C9" FontSize="12" FontWeight="SemiBold" />
              <TextBox Text="{Binding MinMaxTtsModelId}" />
            </StackPanel>

          </StackPanel>
        </ScrollViewer>

        <!-- Workspace Category -->
        <ScrollViewer IsVisible="{Binding IsWorkspaceSelected}">
          <StackPanel Spacing="16">
            <TextBlock Text="Workspace Alanı" FontSize="20" FontWeight="Bold" Foreground="#3FD5FF" />
            <Border Height="1" Background="#173B55" />
            <TextBlock Text="Çalışma Dizini Yetkilendirmeleri" Foreground="#9FB7C9" FontSize="12" FontWeight="SemiBold"/>
            <TextBox Text="~/workspace" IsReadOnly="True" />

            <TextBlock Text="Sunucuya Bağlı Vortex Yapay Zeka Asistanı Cihazı" Foreground="#3FD5FF" FontSize="16" FontWeight="SemiBold" Margin="0,12,0,0"/>
            <TextBlock Text="Bu seçim, Vortex.Server üzerinden sıraya alınan kişisel Vortex Yapay Zeka Asistanı işlemleri içindir. Doğrudan bu bilgisayardaki çevrimdışı asistan bağlantısından ayrıdır." Foreground="#8EA8BC" FontSize="11" TextWrapping="Wrap"/>
            <ComboBox ItemsSource="{Binding RegisteredLocalAgentDevices}" SelectedItem="{Binding SelectedLocalAgentDevice}" HorizontalAlignment="Stretch">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding DeviceName}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Text="{Binding SelectedLocalAgentDeviceDetail}" Foreground="#BFDBFE" FontSize="11" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="Yenile" Command="{Binding RefreshLocalAgentDevicesCommand}" Background="#1c2c4c"/>
              <TextBlock Text="Yükleniyor..." IsVisible="{Binding IsLocalAgentDeviceLoading}" Foreground="#BFDBFE" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="{Binding LocalAgentDeviceStatusText}" Foreground="#8EA8BC" FontSize="11" TextWrapping="Wrap"/>

            <TextBlock Text="Çevrimdışı Cihaz Eylemleri" Foreground="#9FB7C9" FontSize="12" FontWeight="SemiBold" Margin="0,12,0,0"/>
            <TextBlock Text="Bu bilgisayardaki çevrimdışı Vortex Yapay Zeka Asistanı eylem yürütücüsü otomatik olarak hazırlanır ve güvenli biçimde başlatılır. İnternet, Vortex.Server, hesap veya elle girilen bir anahtar gerekmez." Foreground="#8EA8BC" FontSize="11" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding LocalAgentStatusText}" Foreground="#BFDBFE" FontSize="12" TextWrapping="Wrap"/>
            <Button Content="Onar" Command="{Binding TestLocalAgentConnectionCommand}" Background="#1c2c4c" HorizontalAlignment="Left"/>

            <TextBlock Text="Zamanlanmış Görevler" Foreground="#3FD5FF" FontSize="16" FontWeight="SemiBold" Margin="0,16,0,0"/>
            <TextBlock Text="Vortex Yapay Zeka Asistanınız bu görevleri sunucudaki kişisel çalışma alanınızda otomatik çalıştırır. Örnek: her sabah 06:00'da e-postalarımı kontrol et. Zamanlama 5 alanlı cron biçimindedir (dakika saat ayın-günü ay haftanın-günü)." Foreground="#8EA8BC" FontSize="11" TextWrapping="Wrap"/>
            <TextBox Text="{Binding ScheduledTaskName}" PlaceholderText="Görev adı / talimat (ör. E-postalarımı kontrol et)" />
            <TextBox Text="{Binding ScheduledTaskSchedule}" PlaceholderText="Cron zamanlaması (ör. 0 6 * * *)" />
            <TextBox Text="{Binding ScheduledTaskTimeZone}" PlaceholderText="Saat dilimi (boş bırakılırsa yerel saat)" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="Görev Ekle" Command="{Binding CreateScheduledTaskCommand}" Background="#1c2c4c"/>
              <Button Content="Yenile" Command="{Binding RefreshScheduledTasksCommand}" Background="#1c2c4c"/>
              <TextBlock Text="Yükleniyor..." IsVisible="{Binding IsScheduledTasksLoading}" Foreground="#BFDBFE" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="{Binding ScheduledTasksStatusText}" Foreground="#BFDBFE" FontSize="11" TextWrapping="Wrap"/>
            <ItemsControl ItemsSource="{Binding ScheduledTasks}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Background="#12233A" CornerRadius="6" Padding="8" Margin="0,4,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                      <StackPanel>
                        <TextBlock Text="{Binding Name}" Foreground="#F4FBFF" FontSize="12" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Schedule}" Foreground="#8EA8BC" FontSize="11"/>
                      </StackPanel>
                      <Button Content="Sil"
                              Command="{Binding $parent[ItemsControl].DataContext.DeleteScheduledTaskCommand}"
                              CommandParameter="{Binding}"
                              Background="#3a1c2c" VerticalAlignment="Center"/>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>

        <!-- Notifications Category -->
        <ScrollViewer IsVisible="{Binding IsNotificationsSelected}">
          <StackPanel Spacing="16">
            <TextBlock Text="Bildirim Tercihleri" FontSize="20" FontWeight="Bold" Foreground="#3FD5FF" />
            <Border Height="1" Background="#173B55" />
            <CheckBox Content="Ses bittiğinde bildirim sesi çal" IsChecked="True" Foreground="#F4FBFF" />
          </StackPanel>
        </ScrollViewer>

        <!-- Advanced Category -->
        <ScrollViewer IsVisible="{Binding IsAdvancedSelected}">
          <StackPanel Spacing="16">
            <TextBlock Text="Gelişmiş Seçenekler" FontSize="20" FontWeight="Bold" Foreground="#3FD5FF" />
            <Border Height="1" Background="#173B55" />
            <Button Content="Tüm Yerel Önbelleği Temizle" HorizontalAlignment="Stretch" Background="#1c2c4c"/>
          </StackPanel>
        </ScrollViewer>

        <!-- About Category -->
        <ScrollViewer IsVisible="{Binding IsAboutSelected}">
          <StackPanel Spacing="16">
            <TextBlock Text="Vortex Hakkında" FontSize="20" FontWeight="Bold" Foreground="#3FD5FF" />
            <Border Height="1" Background="#173B55" />
            <TextBlock Text="Vortex Yapay Zeka Asistanı" FontSize="15" FontWeight="SemiBold" Foreground="#F4FBFF" />
            <TextBlock Text="Sürüm: 1.0.0" Foreground="#8EA8BC" />
            <TextBlock Text="Copyright © 2026 Okan Özbay — MIT" Foreground="#8EA8BC" />
            <Button Content="Vortex Yapay Zeka Asistanı Kurulum sihirbazını yeniden çalıştır" Command="{Binding RerunSetupWizardCommand}" HorizontalAlignment="Left" />
          </StackPanel>
        </ScrollViewer>

        <!-- Archived Chats Category -->
        <Grid IsVisible="{Binding IsArchivedChatsSelected}" RowDefinitions="Auto,*,Auto">
          <StackPanel Grid.Row="0" Spacing="8" Margin="0,0,0,10">
            <TextBlock Text="Arşivlenmiş Sohbetler" FontSize="20" FontWeight="Bold" Foreground="#3FD5FF" />
            <Border Height="1" Background="#173B55" />
            <TextBox PlaceholderText="Arşivde ara..." Text="{Binding ArchivedSearchText}" />
          </StackPanel>

          <ScrollViewer Grid.Row="1">
            <ItemsControl ItemsSource="{Binding ArchivedChats}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Background="#111A2A" CornerRadius="8" Padding="10" Margin="0,0,0,6" BorderBrush="#173B55" BorderThickness="1">
                    <Grid ColumnDefinitions="*,Auto,Auto">
                      <TextBlock Grid.Column="0" Text="{Binding Title}" Foreground="#F4FBFF" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                      <Button Grid.Column="1" Content="Geri Al" Command="{Binding $parent[Window].DataContext.UnarchiveChatCommand}" CommandParameter="{Binding}" Margin="0,0,8,0" Background="#1c2c4c"/>
                      <Button Grid.Column="2" Content="Sil" Command="{Binding $parent[Window].DataContext.DeleteChatCommand}" CommandParameter="{Binding}" Foreground="#F87171" Background="#1c2c4c"/>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>

          <TextBlock Grid.Row="2" Text="{Binding ArchivedChatsStatusText}" Foreground="#8EA8BC" FontSize="12" Margin="0,10,0,0" TextAlignment="Center"/>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>
