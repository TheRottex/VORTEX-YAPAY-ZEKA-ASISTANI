<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <SelfContained Condition="'$(RuntimeIdentifier)' == 'linux-x64'">true</SelfContained>
    <UseAppHost Condition="'$(RuntimeIdentifier)' == 'linux-x64'">true</UseAppHost>
    <UseAppHost Condition="'$(RuntimeIdentifier)' != 'linux-x64'">false</UseAppHost>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <Authors>Okan Özbay</Authors>
    <Company>Okan Özbay</Company>
    <Product>Vortex Yapay Zeka Asistanı</Product>
    <Copyright>Copyright (c) 2026 Okan Özbay</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Vortex.Shared\Vortex.Shared.csproj" />
    <ProjectReference Include="..\Vortex.LocalAgent\Vortex.LocalAgent.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.1" />
    <PackageReference Include="Avalonia.Controls.WebView" Version="12.0.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.92.0" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="System.Speech" Version="8.0.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets/Web/**" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\whisper\Release\**"
             Exclude="..\whisper\Release\artifacts\**;..\whisper\Release\bin\**;..\whisper\Release\obj\**;..\whisper\Release\**\*.exe;..\whisper\Release\**\*.dll"
             Link="whisper\Release\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             Condition="'$(RuntimeIdentifier)' == 'linux-x64'" />
    <Content Include="..\whisper\Release\**"
             Exclude="..\whisper\Release\artifacts\**;..\whisper\Release\bin\**;..\whisper\Release\obj\**"
             Link="whisper\Release\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             Condition="'$(RuntimeIdentifier)' != 'linux-x64'" />
    <AvaloniaResource Include="Assets/VortexOrb.png" />
  </ItemGroup>

  <Target Name="CopyLocalAgentCompanion" AfterTargets="Build">
    <ItemGroup>
      <LocalAgentCompanion Include="..\Vortex.LocalAgent\bin\$(Configuration)\net8.0\**\*"
                           Exclude="..\Vortex.LocalAgent\bin\$(Configuration)\net8.0\.vortex-ssh\**;..\Vortex.LocalAgent\bin\$(Configuration)\net8.0\artifacts\**;..\Vortex.LocalAgent\bin\$(Configuration)\net8.0\bin\**;..\Vortex.LocalAgent\bin\$(Configuration)\net8.0\obj\**" />
    </ItemGroup>
    <Copy SourceFiles="@(LocalAgentCompanion)"
          DestinationFiles="@(LocalAgentCompanion->'$(OutDir)local-agent\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <!-- Publish must also carry a RID-specific companion under local-agent/ so end users get a
       working zero-config executor without installing Vortex.LocalAgent separately. -->
  <PropertyGroup>
    <LocalAgentCompanionPublishDir>..\Vortex.LocalAgent\obj\local-agent-publish\$(Configuration)\$(RuntimeIdentifier)\</LocalAgentCompanionPublishDir>
  </PropertyGroup>

  <Target Name="PublishLocalAgentCompanion" AfterTargets="Publish" Condition="'$(RuntimeIdentifier)' != ''">
    <MSBuild Projects="..\Vortex.LocalAgent\Vortex.LocalAgent.csproj"
             Targets="Publish"
             Properties="Configuration=$(Configuration);RuntimeIdentifier=$(RuntimeIdentifier);SelfContained=$(SelfContained);UseAppHost=$(UseAppHost);NoBuild=false;BuildProjectReferences=true;PublishDir=$(LocalAgentCompanionPublishDir)" />
    <ItemGroup>
      <LocalAgentCompanionPublish Include="$(LocalAgentCompanionPublishDir)**\*"
                                  Exclude="$(LocalAgentCompanionPublishDir).vortex-ssh\**;$(LocalAgentCompanionPublishDir)artifacts\**;$(LocalAgentCompanionPublishDir)bin\**;$(LocalAgentCompanionPublishDir)obj\**" />
    </ItemGroup>
    <Copy SourceFiles="@(LocalAgentCompanionPublish)"
          DestinationFolder="$(PublishDir)local-agent"
          SkipUnchangedFiles="true" />
  </Target>

  <!-- Nested backup/sample tree must not compile (AVLN2002 duplicate x:Class risk). -->
  <ItemGroup>
    <Compile Remove="Login sistemleri vs burada/**" />
    <AvaloniaXaml Remove="Login sistemleri vs burada/**" />
    <None Remove="Login sistemleri vs burada/**" />
    <EmbeddedResource Remove="Login sistemleri vs burada/**" />
  </ItemGroup>

</Project>


