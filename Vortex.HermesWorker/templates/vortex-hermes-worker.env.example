# Vortex Hermes Worker WSL environment template
# Copy to a private, chmod 600 environment file and replace only the placeholders.
# Never store a real token, API key, HMAC secret, or private seed content in this template.

VORTEX_SERVER_URL=https://vortex.example.invalid
VORTEX_WORKER_ID=wsl-hermes-worker-01
VORTEX_WORKER_DATA=/home/<user>/vortex-worker-data
VORTEX_WORKER_TOKEN=<set-through-private-environment-mechanism>

VORTEX_HERMES_EXECUTION_MODE=docker
VORTEX_DOCKER_HERMES_IMAGE=registry.local/vortex/hermes:0.18.2
HERMES_CONFIG_SEED_PATH=/home/<user>/.hermes/config.yaml
HERMES_ENV_SEED_PATH=/home/<user>/.hermes/.env

# Docker resource controls. The worker enforces the server job RuntimeMemoryLimitMb and a 512 MiB maximum.
VORTEX_DOCKER_MEMORY_LIMIT_MB=512
VORTEX_DOCKER_MEMORY_SWAP_LIMIT_MB=512
VORTEX_DOCKER_PIDS_LIMIT=128
VORTEX_DOCKER_CPU_LIMIT=<POSITIVE_CPU_LIMIT_E.G._0.5>

# Docker-container-to-WSL-local CLIProxy connection. Do not put its key here.
OPENAI_BASE_URL=http://host.docker.internal:8317/v1

VORTEX_WORKER_IDLE_POLL_SECONDS=3
VORTEX_WORKER_LEASE_SECONDS=60
VORTEX_REQUIRE_PRIVATE_SERVER_ENDPOINT=false
