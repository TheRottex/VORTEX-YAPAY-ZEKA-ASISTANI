# Vortex Hermes Worker WSL environment template
# Copy to /home/<USER>/vortex-worker/secrets/worker.env, chmod 600 it,
# and replace placeholders only. Never commit real token, API key, seed, or user data.

VORTEX_SERVER_URL=<VORTEX_SERVER_URL>
VORTEX_WORKER_ID=<WORKER_ID>
VORTEX_WORKER_DATA=/home/<USER>/vortex-worker/data
VORTEX_WORKER_TOKEN=<WORKER_TOKEN>

# Docker is mandatory. Worker does not fall back to process mode.
VORTEX_HERMES_EXECUTION_MODE=docker
# Build this image locally from Vortex.HermesWorker/docker; do not assume a public registry image exists.
VORTEX_DOCKER_HERMES_IMAGE=<HERMES_DOCKER_IMAGE>
HERMES_CONFIG_SEED_PATH=/home/<USER>/vortex-worker/secrets/config.yaml
HERMES_ENV_SEED_PATH=/home/<USER>/vortex-worker/secrets/.env

# Docker resource controls. Host worker UID:GID is passed with docker --user.
# Container home is always /vortex/hermes-home. No root, chown, or fallback is used.
VORTEX_DOCKER_MEMORY_LIMIT_MB=512
VORTEX_DOCKER_MEMORY_SWAP_LIMIT_MB=512
VORTEX_DOCKER_PIDS_LIMIT=128
VORTEX_DOCKER_CPU_LIMIT=0.5

# User-specific OpenAI-compatible provider/router endpoint and private API key.
OPENAI_BASE_URL=<OPENAI_COMPATIBLE_API_URL>
OPENAI_API_KEY=<OPENAI_API_KEY>

VORTEX_WORKER_IDLE_POLL_SECONDS=3
VORTEX_WORKER_LEASE_SECONDS=60
VORTEX_REQUIRE_PRIVATE_SERVER_ENDPOINT=false
