@page
@model IndexModel
@{
    ViewData["Title"] = "Vortex";
}

<section class="py-5 text-center">
    <p class="text-uppercase text-info fw-semibold">Vortex</p>
    <h1 class="display-5">Public server için güvenli web paneli</h1>
    <p class="lead text-muted mx-auto" style="max-width: 42rem;">Hesabınıza giriş yapın, profilinizi ve kayıtlı cihazlarınızı görüntüleyin.</p>
    <div class="d-flex gap-2 justify-content-center">
        <a class="btn btn-primary" asp-page="/Login">Giriş yap</a>
        <a class="btn btn-outline-secondary" asp-page="/Register">Hesap oluştur</a>
    </div>
</section>
