@page "/login"
@model Vortex.Web.Pages.LoginModel
@{
    ViewData["Title"] = "Giriş";
}

<section class="auth-card">
    <p class="text-uppercase text-info fw-semibold">Vortex</p>
    <h1>Giriş yap</h1>
    <p class="text-muted">Public Vortex server hesabınızla devam edin.</p>
    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage)) { <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div> }
    <form method="post">
        <input type="hidden" asp-for="ReturnUrl" />
        <div class="mb-3"><label class="form-label" asp-for="Email">E-posta</label><input class="form-control" asp-for="Email" type="email" autocomplete="email" required /></div>
        <div class="mb-3"><label class="form-label" asp-for="Password">Parola</label><input class="form-control" asp-for="Password" type="password" autocomplete="current-password" required /></div>
        <button type="submit" class="btn btn-primary w-100">Giriş yap</button>
    </form>
    <p class="mt-3 mb-0 text-center">Hesabınız yok mu? <a asp-page="/Register" asp-route-ReturnUrl="@Model.ReturnUrl">Hesap oluşturun</a>.</p>
</section>
